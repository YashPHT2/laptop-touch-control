<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0C">

    <!-- ============ connect screen ============ -->
    <LinearLayout
        android:id="@+id/connectPanel"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/input_bg"
            android:layout_marginBottom="24dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="&#9000;"
                android:textSize="26sp"
                android:textColor="#35D0A5" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Laptop Touch Control"
            android:textColor="#F4F3F1"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scan the QR code on your laptop, or type the address"
            android:textColor="#6B6964"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <Button
            android:id="@+id/scanBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/btn_secondary"
            android:text="Scan QR code"
            android:textColor="#35D0A5"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:stateListAnimator="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="18dp"
            android:text="or"
            android:textColor="#3A3A36"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/serverInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/input_bg"
            android:hint="192.168.1.10:8080"
            android:textColorHint="#6B6964"
            android:textColor="#F4F3F1"
            android:textSize="15sp"
            android:gravity="center"
            android:inputType="textUri"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/connectBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/btn_primary"
            android:text="Connect"
            android:textColor="#06251C"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:stateListAnimator="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Same Wi-Fi, or anywhere with Tailscale"
            android:textColor="#3A3A36"
            android:textSize="12sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- ============ remote session (WebView) ============ -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
